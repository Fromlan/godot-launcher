{
  "name": "godot-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Godot 启动器,管理 Godot 版本/项目/插件的桌面应用",
  "type": "module",
  "main": "dist-main/main/index.js",
  "author": "Godot Launcher Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fromlan/godot-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/Fromlan/godot-launcher/issues"
  },
  "homepage": "https://github.com/Fromlan/godot-launcher#readme",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/dev.mjs --clean",
    "dev:reset": "node scripts/dev.mjs --reset",
    "dev:debug": "node scripts/dev.mjs --debug",
    "dev:inspect": "node scripts/dev.mjs --inspect",
    "dev:reset-debug": "node scripts/dev.mjs --reset --debug",
    "dev:port": "node scripts/dev.mjs --port 5174",
    "build:main": "tsc -p tsconfig.node.json && node scripts/write-pkg-type.mjs dist-main commonjs",
    "build:preload": "tsc -p tsconfig.preload.json && node scripts/write-pkg-type.mjs dist-preload commonjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build:main && npm run build:preload && cross-env NODE_ENV=production electron .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run build",
    "test": "npm run test:unit && npm run test:e2e",
    "package": "npm run build && electron-builder --win nsis",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" .prettierrc.*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.48.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "undici": "^6.19.0",
    "yauzl": "^3.1.3",
    "zustand": "^4.5.0"
  }
}
