{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-main",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/preload/**", "src/renderer/**", "src/tests/**"]
}
