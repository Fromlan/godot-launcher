{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist-preload",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src/preload/**/*.ts", "src/shared/**/*.ts"]
}
